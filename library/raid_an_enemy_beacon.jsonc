//
// raid_an_enemy_beacon.jsonc: the Raid template (S2's plan, task `opra`;
// spec sections 4, 6 and 14).
//
// It teaches the raid: walk to your core, place an Attack beacon beside it,
// and let its raiders do the rest. An Attack beacon fields raiders, gathers
// them at its staging point, and launches them as soon as its launch
// condition holds. They walk to the target and fight it: an enemy beacon is
// hit at its weak point, the lowest-HP structure of that seat's inside its
// sphere, else the beacon itself. If the target has moved or died when they
// arrive, "nearest known" sends them on to the nearest enemy beacon you have a
// fresh sighting of. They break off once fewer than half the launch force
// is left -- with two raiders, as soon as one is lost -- and the survivors
// regroup at the staging point.
//
// What to raid is yours to say: the nearest enemy beacon you know of,
// {"beacon": {"nearest": {"filter": {"side": "ENEMY_KNOWN"}}}}, which is the
// template's own; an enemy beacon by the name your beacon list gives it, such
// as {"beacon": {"beacon_id": "e_01"}}; the enemy commander,
// {"enemy_commander": {}}, or {"enemy_commander": {"seat": 1}} for one
// seat's; or a voxel. A beacon by name, or one seat's commander, that you
// have never seen or not seen recently is refused at the seal. The nearest
// enemy beacon, and the enemy commander with no seat named, are chosen when
// the force is ready to launch, from the sightings you have then: nearest the
// staging point, among those seen recently. Until you have one the raiders
// wait at the staging point, and the checks say so. The wizard offers the
// nearest enemy beacon you know of by name, which is what the built-in
// operator suggests. The template's own staging point is the middle of the
// map, which is why the wizard asks for it.
//
// Where the beacon goes is a description, as in Defend the Core: "the nearest
// scrap seam to you", read once your commander stands at the core, which is
// your starting seam beside it. The staging point is a voxel; the built-in
// operator suggests the post's own site, so the raiders gather at home.
{
  "schema_version": {"major": 1, "minor": 0},
  "meta": {
    "parameters": [
      // Why: the post stands beside the core, where your commander already
      // is.
      {"pointer": "/declarative/route/1/place_beacon/at/covering", "label": "Which scrap seam the raid post covers: the nearest one to your core, or one by name"},
      // Why: the target is the raid. A name is a fixed target, pinned at the
      // seal; the nearest enemy beacon is chosen at launch; the enemy commander
      // is followed while any of your units sees it.
      {"pointer": "/declarative/route/1/place_beacon/initial/mandate/attack/target", "label": "What to raid: the nearest enemy beacon you know of, an enemy beacon by name, the enemy commander, or a voxel"},
      // Why: the raiders gather here before they launch, and regroup here
      // after the raid.
      {"pointer": "/declarative/route/1/place_beacon/initial/mandate/attack/staging", "label": "Where the raiders gather before they launch: a voxel"},
      // Why: holding keeps your commander at home while the raid runs. A
      // duration is game milliseconds.
      {"pointer": "/declarative/route/2/hold/ms", "label": "How long to stand by the raid post, in game milliseconds"}
    ],
    "title": "Raid an Enemy Beacon",
    "author_kind": "BUILTIN",
    "note": "Walk to your core, place an Attack beacon beside it, and send its raiders against the nearest enemy beacon you know of."
  },
  "kind": "TEMPLATE",
  "declarative": {
    "route": [
      // Why: the post's description reads from where your commander stands,
      // so the commander walks home first.
      {"label": "to_core", "move": {"to": {"beacon_anchor": {"beacon_id": "b_00"}}}},
      // Why: the step walks to the site it reads, so its timeout bounds the
      // walk as well as the deploy. Two raiders launch together, fewer than
      // half of them left (51 %: one of two lost) breaks the raid off, and one
      // wave goes out a segment.
      // The staging point is the middle of the 384 x 384 map, the one voxel
      // that means the same from either seat's core.
      {"label": "place_raid", "place_beacon": {"at": {"covering": {"seam": {"rank": "NEAREST", "coverage": "ANY"}}}, "tags": ["raid"],
        "initial": {"priority": "NORMAL", "mandate": {"roe": "FREE_FIRE", "attack": {
          "target": {"beacon": {"nearest": {"filter": {"side": "ENEMY_KNOWN"}}}},
          "retarget": "NEAREST_KNOWN",
          "staging": {"x": 192, "y": 192, "z": 0},
          "launch": {"force_size": 2},
          "retreat": {"force_below_pct": 51},
          "after_action": "REGROUP_AT_STAGING",
          "waves": 1}}}},
       "timeout_ms": 60000, "on_fail": {"action": "SKIP"}},
      {"label": "hold", "hold": {"ms": 30000}}
    ],
    "handlers": [
      // Why: bravery is an ordinary rule. Hurt and under fire, the commander
      // walks back to safety and waits before carrying on.
      {"id": "flee", "when": {"all": {"items": [{"cmdr_hp_pct": {"cmp": "LE", "pct": 40}}, {"cmdr_took_damage_within": {"ms": 3000}}]}},
       "body": [{"label": "flee_to_safety", "move": {"to": {"safest": {}}}}, {"label": "flee_wait", "hold": {"ms": 8000}}],
       "resume": "CONTINUE", "cooldown_ms": 30000, "max_fires": 3}
    ]
  },
  "on_death": {"on_respawn": "CONTINUE"},
  // Why: after the hold, wait at the safest beacon you own.
  "fallback": {"hold": {"at": {"safest": {}}}}
}
