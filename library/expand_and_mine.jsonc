//
// expand_and_mine.jsonc: the Expand & Mine template (decisions-log item 81).
//
// It teaches the route and the economy: walk out, put a Mine beacon down
// beside an ore seam, and walk home while its drones dig. Spec section 10's
// worked example, expand_east, is one filled-in copy of it.
//
// This file cannot know where your seams are, so both places below are the
// safest own beacon, which qualifies and places nothing (a beacon cannot stand
// on another). The wizard asks for the site, and the built-in operator's
// suggestion names one at the edge of your own sphere.
{
  "schema_version": {"major": 1, "minor": 0},
  "meta": {
    "parameters": [
      // Why: the walk comes first, because a beacon is placed within the
      // commander's placement range of where it stands.
      {"pointer": "/declarative/route/0/move/to", "label": "Where to walk to before placing"},
      // Why: a new beacon's site must lie inside one of your own spheres, so
      // the reach of an expansion is one sphere radius per beacon.
      {"pointer": "/declarative/route/1/place_beacon/at", "label": "Where the Mine beacon goes: inside one of your spheres, beside a seam"},
      // Why: deeper digging reaches more ore and leaves more of the ground
      // open under whatever stands on it. Whole voxels.
      {"pointer": "/declarative/route/1/place_beacon/initial/mandate/mine/dig_max_depth", "label": "How deep the Mine mandate digs, in voxels"}
    ],
    "title": "Expand & Mine",
    "author_kind": "BUILTIN",
    "note": "Walk out to an ore seam, place a Mine beacon beside it, and walk home while it digs."
  },
  "kind": "TEMPLATE",
  "declarative": {
    "route": [
      {"label": "to_site", "move": {"to": {"safest": {}}, "pace": "AVOID_KNOWN_THREATS"}, "timeout_ms": 120000, "on_fail": {"action": "SKIP"}},
      {"label": "place_mine", "place_beacon": {"at": {"safest": {}}, "tags": ["mine"],
        // Initial settings are interface rows: each one commits on its own.
        "initial": {"priority": "NORMAL", "mandate": {"roe": "RETURN_FIRE", "mine": {"dig_max_depth": 4, "flee_on_threat": true}}}},
       "on_fail": {"action": "SKIP"}},
      {"label": "back_home", "move": {"to": {"safest": {}}}}
    ],
    "handlers": [
      // Why: bravery is an ordinary rule. Hurt and under fire, the commander
      // walks back to safety and waits before carrying on.
      {"id": "flee", "when": {"all": {"items": [{"cmdr_hp_pct": {"cmp": "LE", "pct": 40}}, {"cmdr_took_damage_within": {"ms": 3000}}]}},
       "body": [{"label": "flee_to_safety", "move": {"to": {"safest": {}}}}, {"label": "flee_wait", "hold": {"ms": 8000}}],
       "resume": "CONTINUE", "cooldown_ms": 30000, "max_fires": 3}
    ]
  },
  "on_death": {"on_respawn": "CONTINUE", "max_deaths_before_fallback": 2},
  // Why: an expansion is the most exposed thing a seat does, so the tail waits
  // at the safest beacon rather than out at the new one.
  "fallback": {"hold": {"at": {"safest": {}}}}
}
