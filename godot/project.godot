;
; The Pharmakos client project. Godot 4.7.2 exactly (decisions log section 2.7 item 73).
;
; `godot/` sits at the repository root and is ONE OWNABLE UNIT with
; `crates/client-gdext` under AGENTS.md section 6 (item 72): exactly one agent holds both
; at a time, because GDScript has no compiler to catch a merge. `godot/bin/` is the
; staging target the `.gdextension` points at, and `godot/.godot/` is git-ignored, which
; is why `godot --headless --path godot --import` runs FIRST in every CI job and every
; packaging step — see `godot/README.md`.
;
; The four settings below are not preferences. They are the ones spike G1 found decide
; whether a frame number means anything, carried into the product by item 56's
; "Godot's single-safe thread model makes path B's RenderingServer calls legal from
; _process with no render-thread hop":
;
;   * vsync_mode = 0 — frame time is measured, not clamped to the display's refresh
;     interval. Measuring with vsync on measures the display.
;   * run/delta_smoothing = false — Godot 4.7 defaults this to TRUE. It only engages with
;     vsync on, so it is inert here; it is off anyway so that turning vsync on for some
;     other experiment cannot silently start rewriting `delta` into a smoothed estimate.
;   * physics/common/physics_jitter_fix = 0.0 — the thing that actually quantised G1's
;     first measurement. At its 0.5 default, 647 of 1 000 steady frames reported `delta`
;     as exactly 1.3889 ms. It is a PROJECT setting here and not only a line in one
;     scene's `_ready`, because a project setting applies before any scene loads: a scene
;     added later — T16's vista, T19's watch rig — cannot lose it by forgetting to ask.
;     `scripts/client_check.gd` sets `Engine.physics_jitter_fix = 0` as well, belt and
;     braces, and `crates/client-gdext/tests/godot_project.rs` asserts the project
;     setting so a future edit cannot drop it quietly.
;   * rendering_method = forward_plus — the renderer the game ships on.
;   * threads/thread_model = 1, Single-Safe — the main thread owns the RenderingServer,
;     which is what makes path B's RID calls legal from `_process`. Item 56 rests on it.
;
; msaa_3d = 0 is G1's too, and it is the reason the mesher's T-junctions have never shown:
; every vertex coordinate is a small exact integer in f32 with MSAA off.

config_version=5

[application]

config/name="Pharmakos"
config/description="PHARMAKOS: THE SEALED ORDER — client."
run/main_scene="res://scenes/client_check.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/quit_on_go_back=true
run/disable_stderr=false
run/delta_smoothing=false

[debug]

settings/stdout/print_fps=false
settings/fps/force_fps=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/vsync/vsync_mode=0

[physics]

common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
driver/threads/thread_model=1
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.42, 0.42, 0.44, 1)
limits/opengl/max_renderable_elements=1048576
