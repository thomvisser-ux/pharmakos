//
// T20's demo scenario: the stage demo's shape, three rounds against the
// built-in operator (skeleton-plan section 1.1; decisions-log item 116 (6)(c)).
//
//   seat 0  seals scenarios/skeleton/against-easy.playbook.jsonc through
//           `submit_plan` in every Lull: Hold & Build as Easy fills it for
//           seat 0 on this map, the file against-easy seals once.
//           It qualifies in all three rounds (no run of this file prints a
//           HARNESS line, and crates/gamectl/tests/scenarios.rs holds it to
//           that), so every seal went through the door a player's does.
//   seat 1  is `builtin`: Easy, seated by the runner as `gamectl host` seats
//           it, plans, submits and says ready in each of the three Lulls
//           through its own in-process token.
//
// Three rounds of 180, 60 and 60 seconds. Round 1 is the spec's shortest Push
// and the full-segment chain decisions-log item 116 (6)(e) relies on in place
// of a longer determinism run. Rounds 2 and 3 are short because nothing in
// them can be asserted by event: `event_fired` checks the FIRST time an event
// fires (crates/gamectl/src/scenario/run.rs, the `.min()` over matching
// ticks), and on this map every event either seat reports first fires in
// round 1 but one. So each beat is asserted at its first occurrence, and
// **Easy's later rounds are pinned by the chain alone**: a probe of every event
// kind for both seats found one first occurrence outside round 1 -- seat 0's
// first `step_failed`, at tick 3601 in round 2, asserted below. Since the
// operator's S1 lane the sealed file names its vent, `vent_324_16`, and its
// `place_beacon` walks to the site it reads: in round 2 that vent is covered
// by seat 0's own round-1 beacon and has its Generator, so the carried step
// fails as it starts rather than placing a second beacon -- the demo's F4,
// a carried playbook placing again every round, fails loudly instead
// (docs/design/targeting.md). A
// `plan_sealed` for seat 1 in rounds 2 and 3 is not asserted either: round
// 1's seal meets any later deadline, and the gateway's fallback emits the same
// line (as against-easy.scenario.jsonc says).
//
// Two seats and not one: a one-seat match is decided at its first Push tick,
// because the last seat standing wins (decisions-log item 114 (2)), so nothing
// would be built and round 2 would never open.
//
// The match does not end here: `scenario run` keeps the runner's default round
// limit of six, and the match's end, with save and resume, is on T22's run
// sheet.
//
// WHAT THIS CHAIN DEPENDS ON. scenarios/README.md frames a chain as the triple
// (map seed, playbooks, rules hash). This one also depends on the built-in
// operator (crates/operator) and on the template library (library/): seat 1's
// orders in every round are whatever Easy composes from them, and seat 0's
// playbook is the Hold & Build template as Easy fills it (its header says so,
// and crates/gamectl/tests/operator.rs holds it to that). Hold & Build's shape
// and its own values are the owner's decisions of decisions-log items 119 (9)
// and (10), recorded in library/hold_and_build.jsonc's header. A change to
// either moves this chain, and the pull request that moves it says which.
{
  "format": "pharmakos.scenario.v1",
  "name": "against-easy-three-rounds",
  "summary": "Three rounds against Easy: seat 0 seals Hold & Build as the built-in operator fills it in every Lull, places a Build beacon and completes a Generator on its vent in round 1; seat 1 is a builtin seat played by Easy, which is the first to deliver ore; round 1's recap settles; the chain pins all three rounds.",

  // The seed every committed scenario names, so the four are about one map.
  "map": {
    "seed": "0x00000000ca5caded",
    "generator": "skeleton"
  },

  // Written out: the chain is a claim about these values.
  "rules": "rules/rules.v1.json",

  "seats": [
    { "seat": 0, "kind": "playbook", "playbook": "scenarios/skeleton/against-easy.playbook.jsonc" },
    { "seat": 1, "kind": "builtin" }
  ],

  // Ticks 1 to 3 600 are round 1, 3 601 to 4 800 round 2 and 4 801 to 6 000
  // round 3: a Lull consumes no sim tick.
  "segments": [
    { "index": 0, "length_ms": 180000, "note": "Round 1: 20 Hz x 180 s = 3 600 ticks, the spec's shortest Push." },
    { "index": 1, "length_ms": 60000, "note": "Round 2: 1 200 ticks, pinned by the chain." },
    { "index": 2, "length_ms": 60000, "note": "Round 3: 1 200 ticks, pinned by the chain." }
  ],

  // Events AND hashes. Each deadline is the tick the run first reported the
  // event on plus about a fifth, as the other scenarios' are, except the
  // recap's, which is on the tick.
  "assertions": [
    { "assert": "event_fired", "event": "beacon_placed", "seat": 0, "by_tick": 850,
      "note": "Seat 0's Build beacon, deployed at tick 721 on the site the covering rule read for vent_324_16, its first." },
    { "assert": "event_fired", "event": "structure_completed", "seat": 0, "by_tick": 1550,
      "note": "The Generator on the lean vent, completed at tick @GEN0 by the drone the new beacon fabricated: seat 0's first completed structure." },
    { "assert": "event_fired", "event": "ore_delivered", "seat": 1, "by_tick": 2200,
      "note": "Seat 1's first ore delivery, at tick @ORE1. Seat 0 delivers first in this run, at tick @ORE0 (tests/golden/scenarios/README.md). The player's own ore is on T22's run sheet." },
    { "assert": "event_fired", "event": "step_failed", "seat": 0, "by_tick": 4100,
      "note": "Round 2: seat 0's carried deploy names vent_324_16, which its round-1 beacon covers and its Generator stands on, and the step fails as it starts, at tick @FAIL0 -- seat 0's first failure of the match. Before S1 it stacked a second beacon on the same column (the demo's F4). The failure's reason is not pinned by the chain, which hashes no event (events are derived output: crates/sim/tests/runner.rs's `the_event_bus_is_not_in_the_state_encoding`); the chain pins the world the refusal leaves, with no second beacon on that column." },
    { "assert": "event_fired", "event": "settled", "by_tick": 3600,
      "note": "Round 1's recap settles on the tick its Push ends, the first settlement of the match." },
    { "assert": "hash_chain_equals",
      "golden": "tests/golden/scenarios/against-easy-three-rounds/expected.hashes.txt",
      "note": "All 6 000 ticks of the three rounds, byte-identical on Windows, Linux and macOS and compared across them by the cross-OS guard. This chain moves with the operator and the template library as well as with the seed, the playbooks and the rules; re-blessed with `cargo xtask golden --bless`, and never to turn a red build green." }
  ]
}
