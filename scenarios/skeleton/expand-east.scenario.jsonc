//
// The worked example of the scenario format. scenarios/README.md is the
// specification; xtask/src/scenario.rs is its machine-checkable half, and
// `cargo xtask ci`'s `scenario` step validates this file on every run.
//
// It does not run yet: `gamectl scenario run` arrives at T15, and the hash
// chain it asserts on is committed by the task that first drives a full segment
// (T11's interpreter work). Both are named below at the line that needs them.
{
  "format": "pharmakos.scenario.v1",
  "name": "expand-east-3min",
  "summary": "One sealed playbook walks the commander east, interfaces at the core beacon and places a second one, against a seat that filed the safe playbook.",

  // The seed is a quoted 0x string, not a number: a JSON number is a double in
  // half the world's parsers and a 64-bit seed loses its low bits in one.
  // T5 resolved this line: the seed is in the committed set, and its map digest
  // is the third line of tests/golden/mapgen/expected.digests.txt. The owner
  // still ratifies the seed set as a whole at the stage demo.
  "map": {
    "seed": "0x00000000ca5caded",
    "generator": "skeleton"
  },

  // The third leg of the determinism triple, written out rather than left to
  // the default so the worked example shows it. `rules/rules.v1.json` is the
  // canonical JSON of one gp.v1.RulesTable (item 78); the sim hashes it into
  // `rules_hash`, and the chain asserted on below is a claim about this table's
  // values as much as about this seed.
  "rules": "rules/rules.v1.json",

  "seats": [
    // Seat 0 seals the spec's own worked example, so this scenario and the
    // proto/plan-core goldens exercise the same bytes.
    { "seat": 0, "kind": "playbook", "playbook": "examples/playbooks/expand_east.jsonc" },
    // Seat 1 files the safe playbook — the one the operator files on a timeout,
    // which is written once and tested twice (decisions-log item 81).
    { "seat": 1, "kind": "safe" }
  ],

  // Three minutes is the first rung of the 3 / 5 / 8 ladder (item 68).
  // Milliseconds of game time, never ticks and never a string (item 46).
  "segments": [
    { "index": 0, "length_ms": 180000, "note": "The demo's first Push (plan section 1.1)." }
  ],

  // Events AND hashes. Events alone prove the match did something; hashes alone
  // prove it did the same thing twice; only the pair proves it did the right
  // thing reproducibly.
  "assertions": [
    { "assert": "event_fired", "event": "beacon_placed", "seat": 0, "by_tick": 2400,
      "note": "Two minutes in: the commander has walked a real route and interfaced on site." },
    { "assert": "event_fired", "event": "segment_ended", "by_tick": 3600,
      "note": "20 Hz x 180 s. The segment ends on the tick, not near it." },
    // PLACEHOLDER: the golden does not exist yet. The task that first drives a
    // full segment through the interpreter (T11) commits it, and explains in
    // that PR what the chain covers.
    { "assert": "hash_chain_equals",
      "golden": "tests/golden/scenarios/expand-east-3min/expected.hashes.txt",
      "note": "Byte-identical on Windows, Linux and macOS: gate G4 in the flesh." }
  ]
}
