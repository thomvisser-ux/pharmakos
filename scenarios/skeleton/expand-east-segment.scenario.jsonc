//
// T11's scenario: a full three-minute segment driven by the spec's own worked
// playbook, asserting on events AND on the per-tick hash chain.
//
// It had a sibling, expand-east.scenario.jsonc, and T15 deleted it: that file
// asserted a beacon placed by tick 2400 for a playbook decisions-log item
// 103 (3) had already shown cannot place one, named a golden nobody committed,
// and nothing had ever run it. deploy-and-visit.scenario.jsonc replaces it on
// the same seed and the same two seats, asserting things that hold. This file
// is unchanged by that and names two playbook seats, which is a match the
// skeleton can play — so its chain is committed and compared rather than
// promised.
//
// Two producers write this chain, and both compare it in-test against the
// committed copy: crates/sim/tests/scenario.rs, which drives the sim's own
// runner and also writes the event log beside it, and — since T15 —
// crates/gamectl/tests/scenarios.rs, which plays this file through
// `gamectl scenario run`. The two agree, which is the point: the sim's runner
// and a gateway-hosted match produce the same chain byte for byte.
//
// T15's note: seat 0 cannot *submit* this playbook — it does not qualify
// against seat 0's own frozen snapshot on this map — so the runner seals it
// through its one documented harness door and prints a `note` line saying so
// on every run. crates/gamectl/src/scenario/run.rs has the whole of it, and
// the owner has the question.
{
  "format": "pharmakos.scenario.v1",
  "name": "expand-east-segment",
  "summary": "Two seats seal the worked example and it does not get far, loudly. The commander walks east for the whole of its 120 s timeout without arriving; the eastern site is then out of placement range, so the deploy is refused rather than silently skipped; and the tail step, a walk to `b_01`, is seat 1's own core but somebody else's to seat 0 — so seat 1 walks and seat 0 is refused with `not_own` and takes up its fallback. Nothing here places a beacon, fires a handler or commits a row: at these tuning values the spec's own worked playbook cannot complete its first step on this map, which is a tuning finding for the owner (see the pull request), not a defect this scenario hides.",

  // The same seed the format's worked example names, so the two scenarios are
  // about the same map and a map bug shows up in both.
  "map": {
    "seed": "0x00000000ca5caded",
    "generator": "skeleton"
  },

  // The third leg of the determinism triple. Written out rather than left to
  // the default, because the chain below is a claim about these values as much
  // as about this seed.
  "rules": "rules/rules.v1.json",

  "seats": [
    // Both seats seal the spec's worked example. Its `b_01` is seat 1's core
    // and its eastern site is in neither seat's sphere, which is the point:
    // the transcript shows a timeout, a refusal and a tail, none of them
    // silent.
    { "seat": 0, "kind": "playbook", "playbook": "examples/playbooks/expand_east.jsonc" },
    { "seat": 1, "kind": "playbook", "playbook": "examples/playbooks/expand_east.jsonc" }
  ],

  // Three minutes is the first rung of the 3 / 5 / 8 ladder (item 68).
  // Milliseconds of game time, never ticks and never a string (item 46).
  "segments": [
    { "index": 0, "length_ms": 180000, "note": "20 Hz x 180 s = 3 600 ticks." }
  ],

  // Events AND hashes. Events alone prove the match did something; hashes alone
  // prove it did the same thing twice; only the pair proves it did the right
  // thing reproducibly.
  "assertions": [
    { "assert": "event_fired", "event": "step_started", "seat": 0, "by_tick": 20,
      "note": "The first decision is the Push's first played tick, so the route starts at the start of the segment." },
    { "assert": "event_fired", "event": "step_failed", "seat": 0, "by_tick": 2410,
      "note": "The first failure by this tick is the move's own 120 s timeout (reason 1), and the deploy's illegal site (reason 6) follows five ticks later. The assertion cannot yet tell them apart — `step_failed` carries the reason in `value` and this format has no value predicate — so it is written as what it is: the segment fails loudly rather than silently, twice, before tick 2410. A value predicate is T15's, with the rest of the assertion vocabulary." },
    { "assert": "event_fired", "event": "fallback_engaged", "seat": 0, "by_tick": 2411,
      "note": "Seat 0's tail step names `b_01`, which is seat 1's core: an interface or a walk to another seat's beacon is refused with `not_own` (beacon capture is out of v1), so seat 0's route ends and its guaranteed tail takes over. Seat 1 seals the same file and walks, because for seat 1 `b_01` is its own." },
    { "assert": "event_fired", "event": "segment_ended", "by_tick": 3600,
      "note": "The segment ends on the tick, not near it." },
    { "assert": "hash_chain_equals",
      "golden": "tests/golden/scenarios/expand-east-segment/expected.hashes.txt",
      "note": "Byte-identical on Windows, Linux and macOS: gate G4 in the flesh." }
  ]
}
