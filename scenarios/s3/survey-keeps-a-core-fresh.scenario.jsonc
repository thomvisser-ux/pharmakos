//
// Lane `srvy` (PR #210, fix pass 1): Survey's scouts refresh the sightings
// their seat holds before the next Lull (spec section 6's Survey row;
// decisions-log item 13; item 173 (1): the sentence binds the sightings a seat
// already holds), across Pushes
// longer than the reach window (`verifier.reach_memory_ms`, 180 s), on the
// golden seed, in three rounds of 300 s, 480 s and 480 s.
//
//   seat 0  seals scenarios/s3/survey-keeps-a-core-fresh.playbook.jsonc every
//           round: a Survey beacon beside its core with two scouts and one
//           probe area over seat 1's corner of the map, sixty coarse cells,
//           which the two scouts scan, and scan again as each cell falls due;
//   seat 1  seals nothing, so the gateway files the safe playbook for it.
//
// A scout scanning the corner comes within sight of seat 1's core
// (`enemy_beacon_found`, tick 3986 in round 1) from outside its gun: a scout
// sees 28 columns and the core's autocannon reaches 24 (rules revision 8).
// From then on the seat holds that sighting, and in each Push a scout leaves
// the scan for it: the first `sighting_refreshed` is tick 6131 in round 2,
// and the events log carries every later one (nineteen in all: nine in
// round 2, ten in round 3, the last on tick 24206), so the seat holds the
// sighting inside the window at every Lull although each Push after the
// first is longer than it.
//
// A cell under the gun is no destination while the seat sees the gun
// (S2's plan, decision 12), so a scout walking to one looks at it from the
// edge of its sight, and the cell is marked looked at
// (`survey::seen_under_a_gun`). The walk itself is the router's and prices
// no threat for a scout, so a scout sent to a cell on the far side of a gun
// walks through it. Pinned: six of seat 0's units are destroyed, each
// credited to seat 1 on its tick (10489, 11032, 14334, 17635, 20933 and
// 24247), and the area is never reported surveyed in the match. Read, not
// pinned: they are the Survey post's scouts (the log shows seat 0 field a
// unit within a few ticks of each loss, as the post replaces a scout), shot
// by seat 1's core, the one weapon seat 1 holds; a
// replay of the same staging in the sim alone found each inside the gun's
// range, walking to a cell on its far side or back from one. The beacon
// fields each again (decisions-log item 173 (2), "Refresh wins, accept
// losses"). Whether a scout should route round a gun its seat sees is a
// question held for the owner (S3's `tune3`, Q1b); this file pins the rules
// as they stand.
//
// Until S3's `tune3` the probe area reached north to row 240. At a sight of
// 28 the two scouts scan that larger area west along its northern rows
// first, and come within sight of the core only in round 2 (tick 10631), so
// the area was drawn in to row 304 to keep the find in round 1 and a
// refresh in each of the two longer Pushes.
//
// What a scenario cannot assert, said here so nobody reads it into the file:
// `event_fired` holds from an event's first occurrence on and has no value
// predicate (the register's M-05). So every tick this comment gives is held
// by the events log committed beside the chain
// (tests/golden/scenarios/survey-keeps-a-core-fresh/expected.events.txt) and
// by `the_survey_scenario_pins_its_beats` in crates/gamectl/tests/scenarios.rs,
// which counts the refreshes of each Push; the age at each Lull is pinned by
// the chain, which hashes the sighting table every tick, and by
// crates/sim/tests/survey_refresh.rs, which asserts the age at every Lull on
// the committed seeds.
{
  "format": "pharmakos.scenario.v1",
  "name": "survey-keeps-a-core-fresh",
  "summary": "Seat 0's Survey scouts find seat 1's core in round 1 and refresh its sighting in every later Push, though each Push is longer than the reach window, so seat 0 holds it fresh at every Lull.",

  "map": {
    "seed": "0x00000000ca5caded",
    "generator": "skeleton"
  },

  "rules": "rules/rules.v1.json",
  "round_limit": 3,

  "seats": [
    { "seat": 0, "kind": "playbook", "playbook": "scenarios/s3/survey-keeps-a-core-fresh.playbook.jsonc" },
    { "seat": 1, "kind": "safe" }
  ],

  "segments": [
    { "index": 0, "length_ms": 300000, "note": "Round 1: the post, its two scouts, and the find." },
    { "index": 1, "length_ms": 480000, "note": "Round 2: longer than the reach window; the scouts refresh the core." },
    { "index": 2, "length_ms": 480000, "note": "Round 3: the same again." }
  ],

  "assertions": [
    { "assert": "event_fired", "event": "beacon_placed", "seat": 0, "by_tick": 600,
      "note": "The Survey beacon is placed with its probe area." },
    { "assert": "event_fired", "event": "unit_fabricated", "seat": 0, "by_tick": 1200,
      "note": "The Survey beacon fields its scouts." },
    { "assert": "event_fired", "event": "enemy_beacon_found", "seat": 0, "by_tick": 4000,
      "note": "A scout scanning the corner sees seat 1's core, a beacon seat 0 had never seen." },
    { "assert": "event_fired", "event": "sighting_refreshed", "seat": 0, "by_tick": 6200,
      "note": "In round 2 a scout leaves the scan and renews the core's sighting; the later refreshes are the chain's." },
    { "assert": "hash_chain_equals",
      "golden": "tests/golden/scenarios/survey-keeps-a-core-fresh/expected.hashes.txt",
      "note": "Byte-identical on Windows, Linux and macOS; pins the sighting table every tick, and so each refresh and each Lull's age. Re-blessed with `cargo xtask golden --bless`, and never to turn a red build green." }
  ]
}
