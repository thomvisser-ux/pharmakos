//
// S3's `lic`: seat 0's half of spire-lost.scenario.jsonc. The licence is
// earned as resonance-spire.playbook.jsonc earns it, on the same steps; the
// Spire is queued at the stepping stone, `b_02`, an unarmed beacon far
// forward of the core, so the raid the other seat sends meets no gun there.
//
//   spire   the Spire's queue at the stone: no stone in round 1, `not_licensed`
//           in round 2, queued in round 3, `spire_present` while it stands.
//   stone   the stepping stone toward the second vent, by voxel.
//   cover   a beacon covering the nearest vent the seat does not cover, with a
//           Generator on it.
{
  "schema_version": {"major": 1, "minor": 0},
  "meta": {"title": "Spire lost", "author_kind": "HUMAN"},
  "kind": "PLAYBOOK",
  "declarative": {
    "route": [
      {"label": "spire",
        "interface": {"beacon": {"beacon_id": "b_02"}, "rows": [
          {"queue_structure": {"blueprint_id": "resonance_spire"}}]},
        "timeout_ms": 120000, "on_fail": {"action": "SKIP"}},
      {"label": "stone",
        "place_beacon": {"at": {"voxel": {"x": 196, "y": 66, "z": 31}}},
        "timeout_ms": 120000, "on_fail": {"action": "SKIP"}},
      {"label": "cover",
        "place_beacon": {
          "at": {"covering": {"vent": {"rank": "NEAREST", "coverage": "UNCOVERED"}}},
          "initial": {"mandate": {"build": {"targets": [
            {"blueprint_id": "generator", "anchor": {"on": {"covered": {}}}}
          ]}}}},
        "timeout_ms": 120000, "on_fail": {"action": "SKIP"}}
    ],
    "handlers": []
  },
  "on_death": {"on_respawn": "CONTINUE", "max_deaths_before_fallback": 2},
  "fallback": {"hold": {"at": {"safest": {}}}}
}
