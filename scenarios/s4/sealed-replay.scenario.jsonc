//
// A match played through the external seat, replayed from its sealed files
// (decisions-log item 232).
//
// The match was played on 2026-11-28 with `gamectl match` (item 231): two
// seats, two rounds, seed 0x232. Seat 0 was the outside seat, played by the
// main session's AI, which asked `instantiate_template` for Hold & Build in
// round 1 and Expand & Mine in round 2, each with the operator's suggestions,
// and submitted what came back. Seat 1 was the built-in operator, Easy.
//
//   seat 0  is `sealed`: scenarios/s4/sealed-replay/seat-0/<round>.jsonc, the
//           bytes of the match folder's seats/0/sealed/<round>.jsonc.
//   seat 1  is `sealed` too: what Easy submitted in each round, from
//           seats/1/sealed/. No operator is seated in this replay, so the
//           chain does not move with crates/operator or library/: those
//           decided what the files say, and the files are committed.
//
// Every file goes through `submit_plan` in its round, the door a seat's own
// playbook is sealed through, and a refusal fails the run (scenarios/README.md, "A `sealed`
// seat"). The chain below is the match's own: the two files of its replay/
// folder, one after the other, unchanged. So this scenario holds two claims:
// the seats' sealed files are the whole of what they put into a match, and a
// match found from outside is kept by copying two folders.
//
// The round limit is the match's, two, so the replay ends as the match did,
// at the final audit.
{
  "format": "pharmakos.scenario.v1",
  "name": "sealed-replay",
  "summary": "A two-round match played through the external seat against Easy, replayed from both seats' sealed files: each round's file goes through submit_plan again, and the chain is the one the match itself wrote.",

  "map": {
    "seed": "0x0000000000000232",
    "generator": "skeleton"
  },

  // Written out: the chain is a claim about these values.
  "rules": "rules/rules.v1.json",
  "round_limit": 2,

  // The match's own segment length list: `gamectl match new` names none, so
  // the match took the rules table's, three, five and eight minutes. The list
  // is hashed with the match, so it is stated whole though only two rounds
  // were played.
  "segment_lengths_ms": [180000, 300000, 480000],

  "seats": [
    { "seat": 0, "kind": "sealed", "sealed": "scenarios/s4/sealed-replay/seat-0" },
    { "seat": 1, "kind": "sealed", "sealed": "scenarios/s4/sealed-replay/seat-1" }
  ],

  // The external seat's first two Pushes: three and five minutes.
  "segments": [
    { "index": 0, "length_ms": 180000, "note": "Round 1: 3 600 ticks." },
    { "index": 1, "length_ms": 300000, "note": "Round 2: 6 000 ticks, to tick 9 600." }
  ],

  "assertions": [
    { "assert": "event_fired", "event": "plan_sealed", "seat": 0, "by_tick": 0,
      "note": "Seat 0's round-1 file is sealed as the first Push opens." },
    { "assert": "event_fired", "event": "plan_sealed", "seat": 1, "by_tick": 0,
      "note": "And seat 1's, what Easy submitted." },
    { "assert": "event_fired", "event": "beacon_placed", "seat": 0, "by_tick": 850,
      "note": "Seat 0's Build beacon, at tick 711." },
    { "assert": "event_fired", "event": "structure_completed", "seat": 0, "by_tick": 1500,
      "note": "The Generator on its vent, at tick 1248." },
    { "assert": "event_fired", "event": "ore_delivered", "seat": 1, "by_tick": 1600,
      "note": "Seat 1's first ore, at tick 1342." },
    { "assert": "event_fired", "event": "settled", "by_tick": 3600,
      "note": "Round 1's recap settles on the tick its Push ends." },
    { "assert": "hash_chain_equals",
      "golden": "tests/golden/scenarios/sealed-replay/expected.hashes.txt",
      "note": "All 9 600 ticks, and byte for byte the chain the match wrote to its replay/ folder as it was played through the door." }
  ]
}
