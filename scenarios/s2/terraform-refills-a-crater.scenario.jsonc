//
// S2's `site` (decisions-log item 144 (5)): terraform through the playbook
// door, on the golden seed, in one minute.
//
//   seat 0  seals scenarios/s2/terraform-refills-a-crater.playbook.jsonc: one
//           visit to its core that writes `terraform: FILL` and a mortar
//           anchored at (354, 30, 38), two voxels above the ground. The
//           core's build drones fill the two voxels under the anchor, each at
//           the wall's price, and only then does the Quartermaster buy the
//           mortar, whose footing from that tick ignores every edit (the
//           owner's ruling of 2026-10-20);
//   seat 1  seals nothing, so it files the safe playbook.
//
// The crater refill needs a crater, and a playbook makes one only with a
// mortar duel the cores' distance makes long (repair-and-salvage.scenario.jsonc
// says why), so the refill is crates/sim/tests/site.rs'
// `a_mortar_duel_refills_its_craters`, played headless.
{
  "format": "pharmakos.scenario.v1",
  "name": "terraform-refills-a-crater",
  "summary": "Seat 0's core levels a mortar's footprint with FILL before it is bought, then raises it.",

  "map": {
    "seed": "0x00000000ca5caded",
    "generator": "skeleton"
  },

  "rules": "rules/rules.v1.json",
  "round_limit": 1,

  "seats": [
    { "seat": 0, "kind": "playbook", "playbook": "scenarios/s2/terraform-refills-a-crater.playbook.jsonc" },
    { "seat": 1, "kind": "safe" }
  ],

  "segments": [
    { "index": 0, "length_ms": 60000, "note": "The visit, the levelling and the mortar." }
  ],

  "assertions": [
    { "assert": "event_fired", "event": "row_committed", "seat": 0, "by_tick": 200,
      "note": "The settings row commits on the core." },
    { "assert": "event_fired", "event": "structure_queued", "seat": 0, "by_tick": 1200,
      "note": "The mortar is bought once its footprint is level." },
    { "assert": "event_fired", "event": "structure_completed", "seat": 0, "by_tick": 1200,
      "note": "And raised." },
    { "assert": "hash_chain_equals",
      "golden": "tests/golden/scenarios/terraform-refills-a-crater/expected.hashes.txt",
      "note": "Byte-identical on Windows, Linux and macOS; pins the two levelled voxels too. Re-blessed with `cargo xtask golden --bless`, and never to turn a red build green." }
  ]
}
