//
// S2's `atk`: seat 1's commander walks the length of the map and stops
// sixty voxels short of seat 0's core, outside the core's autocannon and
// inside the sphere of seat 0's Attack beacon. See
// hunt-the-commander.scenario.jsonc.
{
  "schema_version": {"major": 1, "minor": 0},
  "meta": {"title": "Walk into sight", "author_kind": "HUMAN"},
  "kind": "PLAYBOOK",
  "declarative": {
    "route": [
      {"label": "south", "timeout_ms": 470000,
        "move": {"to": {"voxel": {"x": 358, "y": 60, "z": 37}}, "pace": "DIRECT"},
        "on_fail": {"action": "SKIP"}}
    ],
    "handlers": []
  },
  "on_death": {"on_respawn": "CONTINUE", "max_deaths_before_fallback": 2},
  "fallback": {"hold": {"at": {"safest": {}}}}
}
