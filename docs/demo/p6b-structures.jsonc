//
// P6b's set-up for the structure names (docs/demo/p6-run-sheet.md, "P6b's
// additions"): on the Probation map, seat 0's core is at (188, 28), and one
// visit to it orders an autocannon, a wall and a mortar on the flat ground
// beside it. Two rules, so that one can be dragged onto the other.
{
  "schema_version": {"major": 1, "minor": 0},
  "meta": {"title": "P6b structures", "author_kind": "HUMAN"},
  "kind": "PLAYBOOK",
  "declarative": {
    "route": [
      {"label": "to_safety", "move": {"to": {"safest": {}}}},
      {"label": "arm_core",
        "interface": {"beacon": {"beacon_id": "b_00"}, "rows": [
          {"set_mandate_settings": {"build": {
            "targets": [
              {"blueprint_id": "autocannon", "anchor": {"voxel": {"x": 196, "y": 20, "z": 27}}},
              {"blueprint_id": "wall", "anchor": {"voxel": {"x": 186, "y": 38, "z": 27}},
                "wall_box": {"min": {"x": 184, "y": 38, "z": 27}, "max": {"x": 188, "y": 38, "z": 30}},
                "order": 1},
              {"blueprint_id": "mortar", "anchor": {"voxel": {"x": 180, "y": 22, "z": 27}}, "order": 2}
            ]
          }}}
        ]},
        "on_fail": {"action": "SKIP"}}
    ],
    "handlers": [
      {"id": "flee", "when": {"all": {"items": [{"cmdr_hp_pct": {"cmp": "LE", "pct": 40}}, {"cmdr_took_damage_within": {"ms": 3000}}]}},
       "body": [{"label": "flee_to_safety", "move": {"to": {"safest": {}}}}, {"label": "flee_wait", "hold": {"ms": 8000}}],
       "resume": "CONTINUE", "cooldown_ms": 30000, "max_fires": 3},
      {"id": "regroup", "when": {"cmdr_deaths": {"deaths": {"op": "GE", "value": 1}}},
       "body": [{"label": "regroup_at_safety", "move": {"to": {"safest": {}}}}],
       "resume": "CONTINUE", "cooldown_ms": 30000, "max_fires": 1}
    ]
  },
  "on_death": {"on_respawn": "CONTINUE"},
  "fallback": {"shadow": {"beacon": {"safest": {}}}}
}
