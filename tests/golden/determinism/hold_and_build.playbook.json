{
  "schema_version": {
    "major": 1
  },
  "meta": {
    "title": "Hold & Build",
    "author_kind": "BUILTIN",
    "note": "Grow the grid: place a Build beacon covering a heat vent you do not cover yet, with a Generator on the vent as its first target, and hold by it."
  },
  "declarative": {
    "route": [
      {
        "label": "place_power",
        "timeout_ms": 60000,
        "on_fail": {
          "action": "SKIP"
        },
        "place_beacon": {
          "at": {
            "covering": {
              "vent": {
                "rank": "NEAREST",
                "coverage": "UNCOVERED"
              }
            }
          },
          "tags": [
            "power"
          ],
          "initial": {
            "mandate": {
              "build": {
                "targets": [
                  {
                    "blueprint_id": "generator",
                    "anchor": {
                      "on": {
                        "covered": {}
                      }
                    },
                    "order": 1
                  }
                ]
              }
            }
          }
        }
      },
      {
        "label": "hold",
        "hold": {
          "ms": 30000
        }
      }
    ],
    "handlers": [
      {
        "id": "flee",
        "when": {
          "all": {
            "items": [
              {
                "cmdr_hp_pct": {
                  "cmp": "LE",
                  "pct": 40
                }
              },
              {
                "cmdr_took_damage_within": {
                  "ms": 3000
                }
              }
            ]
          }
        },
        "body": [
          {
            "label": "flee_to_safety",
            "move": {
              "to": {
                "safest": {}
              }
            }
          },
          {
            "label": "flee_wait",
            "hold": {
              "ms": 8000
            }
          }
        ],
        "resume": "CONTINUE",
        "cooldown_ms": 30000,
        "max_fires": 3
      }
    ]
  },
  "on_death": {
    "on_respawn": "CONTINUE"
  },
  "fallback": {
    "shadow": {
      "beacon": {
        "safest": {}
      }
    }
  },
  "kind": "PLAYBOOK"
}
