//
// safe_playbook.jsonc: the Safe Playbook template (spec section 14).
//
// What the built-in operator files for a seat that seals nothing verified
// before the Lull ends, and what get_safe_plan shows, so a seat can see the
// cost of a timeout. As written here it changes no beacon. The operator's
// route may raise a beacon's Quartermaster priority and set how deep the
// core's starting drone digs (decisions-log item 133); it never places,
// recycles or switches a mandate.
//
// With nothing raised, which is this file's own value, it is also the
// gateway's fallback for a seat no operator advises: crates/gateway's
// SAFE_PLAYBOOK is this template instantiated with no parameters, and
// `the_gateways_fallback_is_the_safe_template_with_nothing_raised` keeps the
// two equal ("written once, tested twice", decisions-log item 81).
//
// Spec section 14 names "the flee and rescue rules". The rescue rides
// `safest`, with no new vocabulary (S2's plan, decision 6): while the
// commander is below full HP, `safest` ranks your beacons whose sphere holds a
// live repair drone ahead of those without, so this route's walk to safety,
// the flee rule's and the shadowing tail all walk a wounded commander to
// where a drone heals it.
{
  "schema_version": {"major": 1, "minor": 0},
  "meta": {
    "title": "Safe playbook",
    "author_kind": "BUILTIN",
    "note": "Easy, seat 0, round 1, told no seed (Easy draws nothing at random). A Survey beacon beside the core, covering the scrap seam seam_23_342, at (25, 345, 29) as its site reads now, whose 2 scouts look over the far half of the map, because you hold no sighting of an enemy beacon from the last 180 s: 30 s of route (Easy fills 56 s of the segment)."
  },
  "kind": "PLAYBOOK",
  "declarative": {
    "route": [{"label":"to_safety","move":{"to":{"safest":{}},"pace":"AVOID_KNOWN_THREATS"}},{"label":"deepen_core","interface":{"beacon":{"beacon_id":"b_00"},"rows":[{"set_mandate_settings":{"mine":{"dig_max_depth":4}}}]},"on_fail":{"action":"SKIP"}},{"label":"survey_post","place_beacon":{"at":{"covering":{"feature_id":"seam_23_342"}},"tags":["survey"],"initial":{"priority":"NORMAL","mandate":{"survey":{"probe_areas":[{"min":{"x":191,"y":0,"z":0},"max":{"x":383,"y":383,"z":63}}],"scout_count":2}}}},"timeout_ms":42200,"on_fail":{"action":"SKIP"}}],
    "handlers": [
      // Why: bravery is an ordinary rule. Hurt and under fire, the commander
      // walks back to safety and waits before carrying on.
      {"id": "flee", "when": {"all": {"items": [{"cmdr_hp_pct": {"cmp": "LE", "pct": 40}}, {"cmdr_took_damage_within": {"ms": 3000}}]}},
       "body": [{"label": "flee_to_safety", "move": {"to": {"safest": {}}}}, {"label": "flee_wait", "hold": {"ms": 8000}}],
       "resume": "CONTINUE", "cooldown_ms": 30000, "max_fires": 3}
    ]
  },
  "on_death": {"on_respawn": "CONTINUE"},
  // Why: once the route is done, stay with the safest beacon rather than hold
  // one spot, so the commander goes with it if another beacon becomes safer.
  "fallback": {"shadow": {"beacon": {"safest": {}}}}
}
