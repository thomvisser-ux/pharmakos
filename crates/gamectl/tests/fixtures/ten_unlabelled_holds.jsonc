      { "hold": { "ms": 1 }, "on_fail": { "action": "SKIP" } },
      { "hold": { "ms": 1 }, "on_fail": { "action": "SKIP" } },
      { "hold": { "ms": 1 }, "on_fail": { "action": "SKIP" } },
      { "hold": { "ms": 1 }, "on_fail": { "action": "SKIP" } },
      { "hold": { "ms": 1 }, "on_fail": { "action": "SKIP" } },
      { "hold": { "ms": 1 }, "on_fail": { "action": "SKIP" } },
      { "hold": { "ms": 1 }, "on_fail": { "action": "SKIP" } },
      { "hold": { "ms": 1 }, "on_fail": { "action": "SKIP" } },
      { "hold": { "ms": 1 }, "on_fail": { "action": "SKIP" } }
    ]
